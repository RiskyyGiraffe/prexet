# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase database and storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Better Auth (server-only except the public app URL above)
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=

# AI Word redlining (server-only)
OPENROUTER_API_KEY=
OPENROUTER_REDLINE_MODEL=google/gemini-2.5-flash-lite

# Mailbox OAuth and AES-256-GCM token encryption (server-only)
# Generate MAIL_TOKEN_ENCRYPTION_KEY with: openssl rand -base64 32
MAIL_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
